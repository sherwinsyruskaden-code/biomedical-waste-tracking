# ---------------------------------------------------------------
# Smart Biomedical Waste Tracking System — environment template
# Copy to .env (PowerShell: Copy-Item .env.example .env) and edit.
# Never commit .env.
# ---------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in invite / password-reset links and CSRF origin checks)
APP_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgres://bwts:bwts_dev_password@localhost:5432/bwts
# Separate database used by the automated test suite (it is wiped by tests!)
TEST_DATABASE_URL=postgres://bwts:bwts_dev_password@localhost:5432/bwts_test

# Session lifetime in hours
SESSION_TTL_HOURS=168
# Set to true when served over HTTPS (adds the Secure flag to cookies)
COOKIE_SECURE=false

# Email (password reset + invitations). Leave SMTP_HOST empty to run in
# "console mail" dev mode: links are printed to the API log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BWTS <no-reply@example.com>"

# Maps (frontend). OpenStreetMap tiles need no key; respect the OSM tile usage policy.
# For heavier use, point this at your own tile server or a provider such as MapTiler.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Optional OSRM-compatible routing service for *planned* routes (leave empty to disable)
ROUTING_URL=

# Demo mode enables the clearly labelled "simulate GPS" tool for admins.
# Simulated points are stored with source=simulated and shown as such on the map.
DEMO_MODE=true

# Background alert job interval (seconds)
ALERT_JOB_INTERVAL_SECONDS=60
